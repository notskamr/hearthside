{
	"schemaVersion": 1,
	"id": "hearthside",
	"version": "${version}",
	"name": "Hearthside",
	"description": "Seamless local split-screen co-op.",
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": ["dev.hearthside.fabric.HearthsideMod"],
		"client": ["dev.hearthside.fabric.client.HearthsideClient"],
		"sodium:config_api_user": ["dev.hearthside.fabric.client.satellite.SodiumGuestOptions"],
		"modmenu": ["dev.hearthside.fabric.client.compat.ModMenuEntry"]
	},
	"mixins": [
		"hearthside.mixins.json",
		{ "config": "hearthside.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
